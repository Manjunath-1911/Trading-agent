# Copy to .env and fill in. Never commit .env.
MODE=PAPER                 # PAPER | LIVE
DRY_RUN=1                  # LIVE + DRY_RUN=0 + a LIVE_ARMED file = real orders
CAPITAL=10000
INITIAL_BALANCE=10000      # the prop firm's static floor hangs off this
MAX_DAILY_LOSS_PCT=3.75
MAX_OVERALL_LOSS_PCT=9.5
DD_CASCADE=4:0.5,6:0.3
RISK_CAP=0.03
MAX_OPEN=3

# MetaTrader 5 (optional: attaches to a running, logged-in terminal when empty)
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL_MAP=US100=NDX100

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
